<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required by the LibraryImport source generator; there is no hand-written unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MiniMcp.Runtime/MiniMcp.Runtime.csproj" />
    <Compile Include="../CheckInfrastructure/CheckRunner.cs" Link="CheckRunner.cs" />
    <Compile Include="../CheckInfrastructure/CheckAssertions.cs" Link="CheckAssertions.cs" />
    <Compile Include="../CheckInfrastructure/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="../CheckInfrastructure/TemporaryTestDirectory.cs" Link="TemporaryTestDirectory.cs" />
    <ProjectReference Include="../../src/MiniMcp.Cli/MiniMcp.Cli.csproj" />
    <None Include="../../examples/settings.local.json;../../examples/policy.readonly.json"
          Link="examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
