<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required by the LibraryImport source generator; there is no hand-written unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>../../src/MiniMcp.Desktop/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MiniMcp.Desktop/MiniMcp.Desktop.csproj" />
    <Compile Include="../CheckInfrastructure/CheckRunner.cs" Link="CheckRunner.cs" />
    <Compile Include="../CheckInfrastructure/CheckAssertions.cs" Link="CheckAssertions.cs" />
    <Compile Include="../CheckInfrastructure/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="../CheckInfrastructure/TemporaryTestDirectory.cs" Link="TemporaryTestDirectory.cs" />
    <None Update="PickerAutomation.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
