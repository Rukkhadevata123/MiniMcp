[Unit]
Description=Cloudflare Tunnel for MiniMcp
Wants=minimcp.service
After=minimcp.service

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file %h/.config/minimcp/tunnel-token
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
