[Unit]
Description=Personal MiniMcp Server

[Service]
Type=simple
WorkingDirectory=%h/apps/MiniMcp
EnvironmentFile=%h/.config/minimcp/environment
ExecStart=/usr/bin/dotnet %h/apps/MiniMcp/MiniMcp.dll
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
