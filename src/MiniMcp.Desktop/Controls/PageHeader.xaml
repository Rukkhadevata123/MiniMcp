<UserControl
    x:Class="MiniMcp.Desktop.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6" Margin="0,0,0,4">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}"
                   TextWrapping="Wrap" AutomationProperties.AutomationId="PageTitle" />
        <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="PageDescription" />
    </StackPanel>
</UserControl>
