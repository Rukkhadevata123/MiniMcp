<Page
    x:Class="MiniMcp.Desktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiniMcp.Desktop.Controls" NavigationCacheMode="Required" Background="Transparent">
    <Grid RowSpacing="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <controls:PageHeader Title="设置" Description="配置项目、连接方式和执行权限，保存后重启生效。" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch" Spacing="16" Padding="0,0,0,8">
            <Border Style="{StaticResource WorkspaceCardStyle}">
            <ContentControl IsEnabled="{Binding CanLoad}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Text="配置文件" Style="{StaticResource WorkspaceSectionTitleStyle}" />
                <TextBox Header="运行配置文件" Text="{Binding RequestedPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="SettingsFilePath" />
                <StackPanel x:Name="SourceActions" Spacing="8">
                    <Button Content="加载此文件" Click="OnReload" HorizontalAlignment="Left" AutomationProperties.AutomationId="LoadSettings" />
                    <Button Content="选择文件…" Click="OnChooseFile" HorizontalAlignment="Left" AutomationProperties.AutomationId="ChooseSettings" />
                    <Button Content="使用默认路径" Click="OnDefaultPath" HorizontalAlignment="Left" AutomationProperties.AutomationId="DefaultSettings" />
                </StackPanel>
                <TextBlock Text="可填写新文件路径，保存时创建文件。相对路径以配置文件所在目录为基准。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding SettingsPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
            </ContentControl>
            </Border>
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Title="操作未完成"
                     Message="{Binding ErrorMessage}" AutomationProperties.AutomationId="SettingsError" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="SettingsMessage" />
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibilityConverter}}" Height="3" />
            <Border Style="{StaticResource WorkspaceCardStyle}">
            <ContentControl IsEnabled="{Binding CanEdit}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <TextBlock Text="运行配置" Style="{StaticResource WorkspaceSectionTitleStyle}" />
                <TextBox Header="项目目录" Text="{Binding ProjectRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="ProjectRootEditor" />
                <Button Content="选择项目目录…" Click="OnChooseProject" HorizontalAlignment="Left" AutomationProperties.AutomationId="ChooseProject" />
                <TextBox Header="本机监听端口（1–65535）" Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxWidth="240" HorizontalAlignment="Left" InputScope="Number" AutomationProperties.AutomationId="PortEditor" />
                <ComboBox Header="认证方式" SelectedIndex="{Binding AuthenticationIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AuthenticationEditor">
                    <ComboBoxItem Content="Cloudflare Access（默认）" />
                    <ComboBoxItem Content="Local（仅本机）" />
                </ComboBox>
                <ContentControl IsEnabled="{Binding IsCloudflareAuthentication}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBox Header="公网地址（HTTPS Origin）" PlaceholderText="https://mcp.example.com"
                             Text="{Binding PublicOrigin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PublicOriginEditor" />
                    <TextBox Header="Cloudflare Team 前缀" Text="{Binding Team, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TeamEditor" />
                    <TextBox Header="应用 AUD" Text="{Binding Audience, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AudienceEditor" />
                    <CheckBox Content="随服务启动 Cloudflare 隧道" IsChecked="{Binding TunnelEnabled, Mode=TwoWay}"
                              AutomationProperties.AutomationId="TunnelEditor" />
                    <TextBox Header="cloudflared 程序路径（留空自动查找）"
                             Text="{Binding CloudflaredPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CloudflaredEditor" />
                    <TextBox Header="隧道 token 文件路径" Text="{Binding TokenFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TokenFileEditor" />
                    <TextBlock Text="配置检查会确认 cloudflared 程序文件存在、token 文件可读且非空。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                </ContentControl>
                <TextBox Header="Bash 路径（仅 FullAccess 必需，留空自动查找）"
                         Text="{Binding BashPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BashPathEditor" />
                <TextBox Header="rg 路径（文本搜索的可选依赖，留空自动查找）"
                         Text="{Binding RgPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RgPathEditor" />
                <TextBox Header="Git 路径（Git 查询的可选依赖，留空自动查找）"
                         Text="{Binding GitPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="GitPathEditor" />
                <TextBlock Text="缺少 rg 或 Git 时，仅对应的查询工具受影响。各模式提供相同的 8 个工具，按各自权限执行。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="保存运行配置" Click="OnSaveSettings" IsEnabled="{Binding CanSaveSettings}"
                        Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SaveSettings" />
                <TextBlock Text="保存配置时按本机策略文件校验。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            </ContentControl>
            </Border>
            <Border Style="{StaticResource WorkspaceCardStyle}">
            <ContentControl IsEnabled="{Binding CanEdit}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
                <TextBlock Text="本机权限策略" Style="{StaticResource WorkspaceSectionTitleStyle}" />
                <TextBlock Text="{Binding PolicyPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="PolicyPath" />
                <TextBlock Text="所有运行配置共用本机用户目录中的策略文件。" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox Header="默认执行模式（下次启动生效）" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ModeEditor">
                    <ComboBoxItem Content="ReadOnly" />
                    <ComboBoxItem Content="ProjectEdit" />
                    <ComboBoxItem Content="FullAccess" />
                </ComboBox>
                <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" AutomationProperties.AutomationId="ModeDescription" />
                <TextBlock Text="{Binding SavedMode}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ActiveMode}" TextWrapping="Wrap" />
                <TextBox Header="恢复记录目录（留空使用本机默认位置）"
                         Text="{Binding RecoveryDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecoveryPathEditor" />
                <TextBlock Text="{Binding DefaultRecoveryPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="应用补丁前会生成完整预览并保存备份，失败时尝试回滚。恢复目录须在项目外，备份包含未提交到 Git 的原始内容。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Expander Header="ProjectEdit 普通补丁上限" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBox Header="不同路径数" Text="{Binding MaxPathsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" />
                        <TextBox Header="实际增删行数" Text="{Binding MaxLinesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" />
                        <TextBox Header="实际增删字节数" Text="{Binding MaxBytesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" />
                        <TextBlock Text="填写非负整数。任一项超限会拒绝整个补丁，等于上限时允许；设为 0 时，该项变更量也须为 0。FullAccess 同样需要通过基础检查并保存恢复记录。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
                <Button Content="保存本机策略" Click="OnSavePolicy" IsEnabled="{Binding CanSavePolicy}"
                        HorizontalAlignment="Left" AutomationProperties.AutomationId="SavePolicy" />
                <TextBlock Text="策略按已保存的运行配置校验。首次使用时，请先保存运行配置。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            </ContentControl>
            </Border>
            <Border Style="{StaticResource WorkspaceCardStyle}">
            <ContentControl IsEnabled="{Binding CanEdit}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock Text="配置检查" Style="{StaticResource WorkspaceSectionTitleStyle}" />
                <Button Content="检查草稿与本机依赖" Click="OnCheck" HorizontalAlignment="Left" AutomationProperties.AutomationId="CheckDraft" />
                <TextBlock Text="{Binding Dependencies}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DraftDependencies" />
            </StackPanel>
            </ContentControl>
            </Border>
            <TextBlock Text="{Binding DraftStatus}" TextWrapping="Wrap" AutomationProperties.AutomationId="DraftStatus" />
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
