<Page x:Class="MiniMcp.Desktop.Views.RecoveryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MiniMcp.Desktop.ViewModels"
    xmlns:controls="using:MiniMcp.Desktop.Controls"
    NavigationCacheMode="Required" Background="Transparent">
    <Grid RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <controls:PageHeader Title="修改记录" Description="查看记录与完整反向预览，确认后恢复文件。" />
        <Grid Grid.Row="1" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{Binding Context}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="RecoveryContext" />
            <ContentControl x:Name="ActionsHost" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="加载记录" Click="OnReload" AutomationProperties.AutomationId="LoadRecords" />
                <Button x:Name="RestoreButton" Content="恢复所选记录…" Click="OnRestore" IsEnabled="{Binding CanRestore}"
                    Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="RestoreRecord" />
            </StackPanel>
            </ContentControl>
            <Grid x:Name="Body" Grid.Row="2" ColumnSpacing="16" RowSpacing="16" SizeChanged="OnBodySizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="ListCard" Style="{StaticResource WorkspaceCardStyle}">
                    <ListView x:Name="RecordList" ItemsSource="{Binding Records}" SelectionChanged="OnSelectionChanged"
                        SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="RecoveryList">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DesktopRecoveryRow">
                                <StackPanel Margin="0,4" Spacing="4">
                                    <TextBlock Text="{x:Bind CreatedText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                    <TextBlock Text="{x:Bind State}" /><TextBlock Text="{x:Bind Error}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Border x:Name="DetailCard" Grid.Column="1" Style="{StaticResource WorkspaceCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Expander Header="记录详情" HorizontalAlignment="Stretch">
                            <TextBox Text="{Binding Metadata}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="200" FontFamily="Consolas"
                                TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="RecoveryMetadata" />
                        </Expander>
                        <TextBox x:Name="DiffText" Grid.Row="1" Header="完整反向预览" Text="{Binding Diff}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                            TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.AutomationId="RecoveryDiff" />
                    </Grid>
                </Border>
            </Grid>
            <ScrollViewer Grid.Row="3" MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                    AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="RecoveryMessage" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
