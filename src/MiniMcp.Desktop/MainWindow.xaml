<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MiniMcp.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MiniMcp">
    <Grid x:Name="Root" Padding="32" Loaded="OnRootLoaded"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="640" Spacing="20" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="MiniMcp" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="本机 MCP 服务" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="从用户 JSON 配置启动 · 本机监听 · 按配置鉴权" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="配置文件" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="ConfigPathText" AutomationProperties.AutomationId="ConfigPath"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="本机策略" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="PolicyPathText" AutomationProperties.AutomationId="PolicyPath"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="最近一次启动配置" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="ProjectText" Text="启动后显示项目" AutomationProperties.AutomationId="Project"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="ConfigurationText" Text="端口和模式取自配置文件" AutomationProperties.AutomationId="Configuration"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="QueryDependenciesText" Text="启动时检查 rg/Git 程序文件；缺失只影响对应查询工具。"
                               AutomationProperties.AutomationId="QueryDependencies" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="BusyIndicator" Width="20" Height="20" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Text="已停止" VerticalAlignment="Center" AutomationProperties.AutomationId="Status"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <TextBlock x:Name="AddressText" Text="启动后显示本机地址" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               AutomationProperties.AutomationId="Address" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="StartButton" Content="启动" Click="OnStartClicked" Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="Start" />
                    <Button x:Name="StopButton" Content="停止" Click="OnStopClicked" IsEnabled="False" AutomationProperties.AutomationId="Stop" />
                </StackPanel>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="Error" />
                <TextBlock Text="修改配置后，停止再启动生效。/mcp 提供 MCP 服务，/healthz 用于健康检查。三种模式都可查询和预演；ProjectEdit 允许普通补丁、拒绝受限批次，FullAccess 允许通过基础检查的补丁和 Bash。实际补丁强制备份。关闭窗口会停止服务。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
