<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MiniMcp.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MiniMcp">
    <Grid x:Name="Root" Padding="32" Loaded="OnRootLoaded"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel MaxWidth="560" Spacing="20" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Text="MiniMcp" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="本机健康检查服务" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="端口 8000 · 仅本机访问" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="BusyIndicator" Width="20" Height="20" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Text="已停止" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="AddressText" Text="启动后显示本机地址" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="StartButton" Content="启动" Click="OnStartClicked" Style="{ThemeResource AccentButtonStyle}" />
                <Button x:Name="StopButton" Content="停止" Click="OnStopClicked" IsEnabled="False" />
            </StackPanel>
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
            <TextBlock Text="启动后可通过 /healthz 检查本机服务。关闭窗口会停止服务。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
