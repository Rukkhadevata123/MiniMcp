# Copy to .env, edit, then load it as explained in README.md. ASP.NET does not load .env automatically.
MCP_ROOT=/home/yoimiya/MiniMcp
MCP_AUTH_MODE=CloudflareAccess
MCP_PUBLIC_URL=https://mcp.yoimiyalove.top
CF_ACCESS_TEAM=replace-with-your-team-prefix
CF_ACCESS_AUD=replace-with-application-audience-tag
MCP_PORT=8000
# All three tools are enabled. Bash runs with the service account's permissions.
# Windows: use C:\Program Files\Git\bin\bash.exe (see README for PowerShell setup).
MCP_BASH_PATH=/bin/bash
